CREATE TABLE LocalPrediction (
    challengeId TEXT NOT NULL,
    betId TEXT NOT NULL,
    kind TEXT NOT NULL,
    optionId TEXT,
    orderedOptionIds TEXT NOT NULL,
    boolValue INTEGER,
    PRIMARY KEY (challengeId, betId)
);

predictionsAll:
SELECT * FROM LocalPrediction;

predictionsForChallenge:
SELECT * FROM LocalPrediction WHERE challengeId = ?;

predictionUpsert:
INSERT OR REPLACE INTO LocalPrediction VALUES (?, ?, ?, ?, ?, ?);

predictionDeleteForChallenge:
DELETE FROM LocalPrediction WHERE challengeId = ?;

predictionClear:
DELETE FROM LocalPrediction;

CREATE TABLE SeenResult (
    challengeId TEXT NOT NULL PRIMARY KEY
);

seenResultInsert:
INSERT OR IGNORE INTO SeenResult VALUES (?);

seenResultContains:
SELECT COUNT(*) FROM SeenResult WHERE challengeId = ?;

seenResultAll:
SELECT challengeId FROM SeenResult;

CREATE TABLE LocalDraft (
    id TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL,
    updatedAt INTEGER NOT NULL
);

draftUpsert:
INSERT OR REPLACE INTO LocalDraft VALUES (?, ?, ?);

draftAll:
SELECT * FROM LocalDraft ORDER BY updatedAt DESC;

draftById:
SELECT * FROM LocalDraft WHERE id = ?;

draftDelete:
DELETE FROM LocalDraft WHERE id = ?;

draftClear:
DELETE FROM LocalDraft;
