    <string name="cc_info_a11y">More info about %1$s</string>
    <string name="cc_label_bet_type">Bet type</string>
    <string name="cc_label_scoring">Scoring</string>
    <string name="cc_help_mode_title">Bet structure</string>
    <string name="cc_help_mode_body">Multiple bets — bundle several questions in one challenge. Great for a themed quiz night or a match-day pack.\n\nSingle bet — one guess question scored by placement across all participants. Use this for one quick, clean prediction.</string>
    <string name="cc_help_deadline_title">Deadline</string>
    <string name="cc_help_deadline_body">Predictions lock at this time. Nobody can submit or change a guess after the deadline. Set it just before the event starts so everyone commits first.</string>
    <string name="cc_help_visibility_title">Who can join</string>
    <string name="cc_help_visibility_body">Friends — your friends can discover this challenge themselves in their Challenges view and join.\n\nInvite only — only the specific people you pick can join. Use this for private groups or when you want to control exactly who competes.\n\nEither way, anyone you share the direct link with can always open and join.</string>
    <string name="cc_help_bets_visible_title">Bets visible</string>
    <string name="cc_help_bets_visible_body">On — everyone can see each other's predictions before the deadline.\n\nOff — predictions stay hidden until the deadline.</string>
    <string name="cc_help_bet_type_title">Bet types</string>
    <string name="cc_help_bet_type_body">Yes / No — simple true or false.\nSingle pick — choose one option from a list.\nRanking — order the top N items.\nTime — guess a clock time.\nDay — guess a date.\nNumber — guess a number.\nMulti-select — pick several options.\nOver / Under — guess above or below a threshold.</string>
    <string name="cc_help_option_type_title">Options</string>
    <string name="cc_help_option_type_body">Custom — type your own choices for the bet.\n\nCountries — pick from a full country list with flags and autocomplete. Use Countries for sports or geography bets.</string>
    <string name="cc_help_top_n_title">Top N ranked</string>
    <string name="cc_help_top_n_body">Only the top N positions count toward scoring. Players must place these positions in the correct order to earn points — anything ranked below position N is ignored.\n\nDefaults to all options. Lower it to score only the top few.</string>
    <string name="cc_help_scoring_title">Scoring</string>
    <string name="cc_help_scoring_body">Closest wins — the nearest guess scores points. Good for hard-to-predict values like a time or score.\n\nExact match — only a spot-on guess scores. Rewards precision.</string>

