<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Universal Links for inbound Firebase email sign-in URLs and (later)
	  shareable challenge / handle deep-links. The matching AASA file is
	  hosted at https://bragwise.firebaseapp.com/.well-known/apple-app-site-association
	  (and in prod we'll add bragwise.app).
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:bragwise.firebaseapp.com</string>
	</array>
	<!--
	  APNs environment for push notifications. Xcode's automatic signing maps
	  `development` for Debug builds; the App Store / TestFlight pipeline rewrites
	  it to `production` on export. Required for `registerForRemoteNotifications`.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
