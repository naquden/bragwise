<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!--
	  Export compliance: app uses only standard HTTPS/TLS (via Firebase) and
	  OS-default keychain storage — no custom or non-exempt encryption. Set
	  to false so App Store Connect skips the export-compliance prompt on
	  every upload.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  Disable Firebase's swizzling of UIApplicationDelegate. We're on the
	  SwiftUI app lifecycle (no AppDelegate), and the proxy only added value
	  when Dynamic Links handled the URL automatically. Dynamic Links is
	  sunset (2025-08-25); we receive the email-link URL ourselves via
	  `.onContinueUserActivity(NSUserActivityTypeBrowsingWeb)` in iOSApp.swift.
	-->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<!--
	  Custom URL scheme. Safari does NOT re-trigger a Universal Link when the
	  tapped https link points at the domain that served the page, so the landing
	  page's iOS "Open in Bragwise" CTA uses `bragwise://<host>/<path>` instead.
	  SwiftUI delivers it to `.onOpenURL` (iOSApp.swift), which hands it to
	  IosLinkBridge.handleInboundUrlFromIos — that normalises it back to https and
	  rejects any host outside TRUSTED_HOSTS.
	  Mirrors FirebaseConfig.APP_URL_SCHEME (shared/commonMain) and
	  functions/src/landingHtml.ts — KEEP IN SYNC.
	  Hand-edited on purpose: GENERATE_INFOPLIST_FILE merges into this file and
	  there is no INFOPLIST_KEY_ build setting for URL types.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>se.atte.bragwise.Bragwise</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bragwise</string>
			</array>
		</dict>
	</array>
	<!--
	  Allow APNs to wake the app for background data pushes so FCM can deliver
	  silent / data-only messages. Foreground + tap handling is done in the
	  UNUserNotificationCenterDelegate (iOSApp.swift).
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
